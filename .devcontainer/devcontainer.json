{
  "name": "MilkDAWp 2",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteEnv": {
    "VCPKG_ROOT": "/opt/vcpkg",
    "VCPKG_DEFAULT_BINARY_CACHE": "/opt/vcpkg-binary-cache",
    "FETCHCONTENT_SOURCE_DIR_JUCE": "/opt/juce-src",
    "CCACHE_DIR": "/opt/ccache"
  },
  // Persists `claude`'s login/config across container rebuilds (no USER
  // directive in the Dockerfile, so the container runs as root -> /root).
  // Without this, rebuilding the devcontainer wipes the login and `claude`
  // asks you to sign in again every time.
  "mounts": [
    "source=milkdawp2-claude-code-config,target=/root/.claude,type=volume"
  ],
  // Optional GPU/display passthrough on a Linux host (§4.10): uncomment to
  // run mdw-view or other display-touching dev tools with the real GPU
  // instead of falling back to Mesa llvmpipe + Xvfb. Add the X11 socket bind
  // as a second entry in the "mounts" array above, alongside the Claude
  // Code config volume -- JSON only allows one "mounts" key.
  // "runArgs": ["--device=/dev/dri", "-e", "DISPLAY=${localEnv:DISPLAY}"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "xaver.clang-format",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "cmake.configureOnOpen": true,
        "cmake.sourceDirectory": "${workspaceFolder}",
        "cmake.defaultConfigurePreset": "dev-linux",
        "C_Cpp.default.compilerPath": "/usr/bin/clang++"
      }
    }
  },
  "postCreateCommand": "cmake --preset dev-linux"
}
