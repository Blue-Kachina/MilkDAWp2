#!/bin/sh
# Pre-commit hook: rejects a commit if any staged C/C++ file is not
# clang-format-clean per .clang-format (0.5). Install with:
#   git config core.hooksPath scripts/hooks
# (this repo does not set core.hooksPath for you, since that's a per-clone
# choice; see CONTRIBUTING.md).

set -eu

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' '*.cc' '*.hh' '*.cpp' '*.hpp' '*.cxx' '*.hxx')

if [ -z "$files" ]; then
  exit 0
fi

if ! command -v clang-format >/dev/null 2>&1; then
  echo "pre-commit: clang-format not found on PATH; skipping format check." >&2
  exit 0
fi

status=0
for f in $files; do
  if [ -f "$f" ] && ! clang-format --dry-run --Werror "$f" >/dev/null 2>&1; then
    echo "pre-commit: $f is not clang-format-clean (run: clang-format -i $f)" >&2
    status=1
  fi
done

exit $status
